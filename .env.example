DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional: enables emailing admins for Holiday/Sick/Sudden-Leave/Late-Arrival requests
# in addition to the existing in-app notification. Leave unset to disable entirely.
# These are Mailgun's SMTP credentials (Sending > Domain settings > SMTP credentials).
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@mg.yourdomain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Team Portal <notifications@yourdomain.com>"
