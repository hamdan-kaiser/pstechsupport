generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("employee")
  shift         String   @default("day")
  magicKey      String   @default("0000")
  totalHolidays Int      @default(28)
  usedHolidays  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  holidayRequests        HolidayRequest[]
  sickRequests           SickRequest[]
  additionalShiftRequests AdditionalShiftRequest[]
  earlyLeaveRequests     EarlyLeaveRequest[]
  lateArrivalRequests    LateArrivalRequest[]
  statsRecords           StatsRecord[]
  timetableEntries       TimetableEntry[]
  swapRequestsFrom       ShiftSwap[]      @relation("SwapFrom")
  swapRequestsTo         ShiftSwap[]      @relation("SwapTo")
  notifications          Notification[]
  iqGameScore            IqGameScore?
}

model IqGameScore {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bestScore    Int      @default(0) // correct answers out of 20, best attempt
  bestTimeMs   Int      @default(0) // total time taken on the best-scoring attempt (tiebreaker)
  attempts     Int      @default(0)
  lastPlayedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HolidayRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String
  status          String   @default("pending")
  previousValues  Json? // snapshot of each affected day's timetable value before approval, for reversal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SickRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String
  status          String   @default("pending")
  previousValues  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdditionalShiftRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  shift           String // the shift value they want to work that day, e.g. "8am"
  reason          String
  status          String   @default("pending")
  previousValues  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EarlyLeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  leaveTime String // e.g. "15:30" — the time they want to leave
  shiftEnd  String // the shift's normal end time that day, e.g. "17:00", for reference/validation
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LateArrivalRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  joiningTime    String // e.g. "12:00" — the time they'll actually join
  shiftStart     String // the shift's normal start time that day, e.g. "09:00", for reference/validation
  reason         String
  status         String   @default("pending")
  previousValues Json? // snapshot of the day's timetable value before approval, for reversal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StatsRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  casesCreated  Int      @default(0)
  casesResolved Int      @default(0)
  inboundCalls  Int      @default(0)
  outboundCalls Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, month, year])
}

model TimetableEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime
  monday        String?
  tuesday       String?
  wednesday     String?
  thursday      String?
  friday        String?
  saturday      String?
  sunday        String?
  overrideDays  Json? // day-keys in this row set by a one-off Holiday/Sick/Additional-Shift
                       // approval rather than a recurring schedule upload — excluded when
                       // carrying a schedule forward into later weeks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, weekStart])
}

model ShiftSwap {
  id                String   @id @default(cuid())
  requesterId       String
  requester         User     @relation("SwapFrom", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId          String
  target            User     @relation("SwapTo", fields: [targetId], references: [id], onDelete: Cascade)
  swapDate          DateTime
  requesterShift    String
  targetShift       String
  targetAccepted    Boolean  @default(false)
  adminApproved     String   @default("pending")
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  refType   String?
  refId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
